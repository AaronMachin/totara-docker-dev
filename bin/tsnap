#!/bin/bash

script_path="$( cd "$(dirname "$0")" ; pwd -P )"
project_path="$( cd $script_path && cd ..; pwd -P )"

# Export all variables defined in .env so php (child process) can see them.
if [[ -f "$project_path/.env" ]]; then
  set -a; source "$project_path/.env"; set +a
fi

# Delegate to PHP implementation (container auto-selected by tphp script if desired)
php "$project_path/bin/helpers/snappy/tsnap_cli.php" "$@"
